/*
 * ============================================================
 *  PLANTILLA DE CREDENCIALES — este archivo SÍ va en Git
 * ============================================================
 *
 *  CÓMO USARLO:
 *    1. Copia este archivo y quítale el ".ejemplo" al nombre:
 *         cp include/secrets.h.ejemplo include/secrets.h
 *    2. Abre include/secrets.h y rellena tus datos reales.
 *
 *  El archivo secrets.h (sin ".ejemplo") está bloqueado por
 *  .gitignore, así que NUNCA se sube al repositorio.
 *
 *  Por qué se hace así (RNF-05): el repositorio guarda la
 *  ESTRUCTURA de lo que hace falta, pero nunca los valores.
 *  Así cualquiera puede ver qué credenciales necesita el
 *  proyecto sin que las tuyas queden expuestas.
 * ============================================================
 */

#pragma once

// --- WiFi ---
// ⚠️ El ESP32 solo se conecta a redes de 2.4 GHz, no a 5 GHz.
//    Tu red detectada: "INFINITUMEB00" (canal 11, señal excelente).
#define WIFI_SSID     "PON_AQUI_EL_NOMBRE_DE_TU_RED"
#define WIFI_PASSWORD "PON_AQUI_LA_CONTRASENA"

// --- Spotify (aún no hace falta; se llena en el paso 4) ---
// Salen de https://developer.spotify.com/dashboard
#define SPOTIFY_CLIENT_ID     ""
#define SPOTIFY_CLIENT_SECRET ""
// Sale del baile de OAuth que se hace UNA vez desde la Mac.
// ⚠️ Este token es tan valioso como una contraseña: da acceso
//    a tu cuenta de Spotify hasta que lo revoques.
#define SPOTIFY_REFRESH_TOKEN ""
